          "rules": [
            {
              "id": "DPX-ELIXIR-GEN_SERVER",
              "name": "gen_server",
              "shortDescription": {
                "text": "Elixir Pattern: Gen Server"
              },
              "fullDescription": {
                "text": "Module 'Phoenix.DebugTest' explicitly adopts OTP GenServer actor behaviour (`use GenServer`)"
              },
              "properties": {
                "category": "otp_behaviour"
              }
            },
            {
              "id": "DPX-ELIXIR-SUPERVISOR",
              "name": "supervisor",
              "shortDescription": {
                "text": "Elixir Pattern: Supervisor"
              },
              "fullDescription": {
                "text": "Module 'Phoenix.Endpoint.Supervisor' adopts OTP Supervisor behaviour (`use Supervisor`)"
              },
              "properties": {
                "category": "otp_behaviour"
              }
            },
            {
              "id": "DPX-ELIXIR-DYNAMIC_SUPERVISOR",
              "name": "dynamic_supervisor",
              "shortDescription": {
                "text": "Elixir Pattern: Dynamic Supervisor"
              },
              "fullDescription": {
                "text": "Module 'Phoenix.Socket.PoolSupervisor' manages dynamic on-demand child processes (`use DynamicSupervisor`)"
              },
              "properties": {
                "category": "otp_behaviour"
              }
            },
            {
              "id": "DPX-ELIXIR-TASK_ASYNC",
              "name": "task_async",
              "shortDescription": {
                "text": "Elixir Pattern: Task Async"
              },
              "fullDescription": {
                "text": "Function 'init/1' coordinates asynchronous parallel tasks / streams via Task module"
              },
              "properties": {
                "category": "actor_concurrency"
              }
            },
            {
              "id": "DPX-ELIXIR-APPLICATION",
              "name": "application",
              "shortDescription": {
                "text": "Elixir Pattern: Application"
              },
              "fullDescription": {
                "text": "Module 'Phoenix' coordinates top-level application startup lifecycle (`use Application`)"
              },
              "properties": {
                "category": "otp_behaviour"
              }
            },
            {
              "id": "DPX-ELIXIR-PROTOCOL_POLYMORPHISM",
              "name": "protocol_polymorphism",
              "shortDescription": {
                "text": "Elixir Pattern: Protocol Polymorphism"
              },
              "fullDescription": {
                "text": "Protocol 'Phoenix.Param' defines extensible polymorphism contract via defprotocol"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-ELIXIR-MACRO_METAPROGRAMMING",
              "name": "macro_metaprogramming",
              "shortDescription": {
                "text": "Elixir Pattern: Macro Metaprogramming"
              },
              "fullDescription": {
                "text": "Module 'Phoenix.Integration.EndpointTest' defines 1 compile-time macro(s) for DSL metaprogramming"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-ELIXIR-PIPELINE_OPERATOR",
              "name": "pipeline_operator",
              "shortDescription": {
                "text": "Elixir Pattern: Pipeline Operator"
              },
              "fullDescription": {
                "text": "Function 'assert_no_compilation_warnings/1' composes functional data transformations across a 4-stage pipe (`|>`)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-ELIXIR-PLUG_PIPELINE",
              "name": "plug_pipeline",
              "shortDescription": {
                "text": "Elixir Pattern: Plug Pipeline"
              },
              "fullDescription": {
                "text": "Module 'Phoenix.Integration.CodeGeneration.AppWithScopesTest' coordinates HTTP connection middleware processing pipeline (`Plug`)"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-ELIXIR-ETS_REGISTRY",
              "name": "ets_registry",
              "shortDescription": {
                "text": "Elixir Pattern: Ets Registry"
              },
              "fullDescription": {
                "text": "Module 'Phoenix.Config' utilizes Registry / :ets shared memory for zero-copy concurrent process lookup and caching"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-ELIXIR-ADAPTER_BEHAVIOUR",
              "name": "adapter_behaviour",
              "shortDescription": {
                "text": "Elixir Pattern: Adapter Behaviour"
              },
              "fullDescription": {
                "text": "Module 'Phoenix.Channel' defines interchangeable Adapter Behaviour contract with 8 callback(s) (join/3, handle_in/1, handle_out/1, handle_info/2, handle_call/3, handle_cast/2, code_change/2, terminate/2)"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-ELIXIR-COMMAND_TAGGED_TUPLE",
              "name": "command_tagged_tuple",
              "shortDescription": {
                "text": "Elixir Pattern: Command Tagged Tuple"
              },
              "fullDescription": {
                "text": "Function handle_call/3 in 'Phoenix.Integration.WebsocketClient' pattern matches on 2 distinct Command tagged tuples"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-ELIXIR-PUB_SUB_PHOENIX",
              "name": "pub_sub_phoenix",
              "shortDescription": {
                "text": "Elixir Pattern: Pub Sub Phoenix"
              },
              "fullDescription": {
                "text": "Module 'Phoenix.Channel.ChannelTest' coordinates real-time distributed Publish/Subscribe topic broadcasting (Phoenix.PubSub)"
              },
              "properties": {
                "category": "actor_concurrency"
              }
            },
            {
              "id": "DPX-ELIXIR-WITH_MONADIC_PIPELINE",
              "name": "with_monadic_pipeline",
              "shortDescription": {
                "text": "Elixir Pattern: With Monadic Pipeline"
              },
              "fullDescription": {
                "text": "Function 'connect/3' implements Railway-oriented Monadic pipeline with 3 sequential pattern matches (`with`)"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-ELIXIR-STRATEGY_DISPATCH",
              "name": "strategy_dispatch",
              "shortDescription": {
                "text": "Elixir Pattern: Strategy Dispatch"
              },
              "fullDescription": {
                "text": "Function 'action/2' dynamically dispatches behavior to pluggable Strategy/Adapter modules"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-ELIXIR-DEFENSIVE_RESCUE_SMELL",
              "name": "defensive_rescue_smell",
              "shortDescription": {
                "text": "Elixir Pattern: Defensive Rescue Smell"
              },
              "fullDescription": {
                "text": "Let-It-Crash Violation: Function 'run/1' in 'Mix.Tasks.Phx.New' defensively swallows errors (`rescue _ -> nil`); let processes fail fast and restart cleanly via Supervisor"
              },
              "properties": {
                "category": "safety"
              }
            },
            {
              "id": "DPX-ELIXIR-UNBOUNDED_PROCESS_SPAWN",
              "name": "unbounded_process_spawn",
              "shortDescription": {
                "text": "Elixir Pattern: Unbounded Process Spawn"
              },
              "fullDescription": {
                "text": "Safety Audit (Unsupervised Process): Function 'terminate/2' in 'Phoenix.Socket.PoolDrainer' calls raw `spawn/spawn_link`; use `Task.Supervisor` for fault tolerance and supervision"
              },
              "properties": {
                "category": "safety"
              }
            },
            {
              "id": "DPX-ELIXIR-STRING_TO_ATOM_VULNERABILITY",
              "name": "string_to_atom_vulnerability",
              "shortDescription": {
                "text": "Elixir Pattern: String To Atom Vulnerability"
              },
              "fullDescription": {
                "text": "Safety Audit (Atom Exhaustion Risk): Function 'join/3' in 'Phoenix.Integration.WebSocketChannelsTest' calls `String.to_atom/1` on dynamic data; use `String.to_existing_atom/1` to prevent VM memory exhaustion"
              },
              "properties": {
                "category": "safety"
              }
            },
            {
              "id": "DPX-ELIXIR-LARGE_MODULE_SRP",
              "name": "large_module_srp",
              "shortDescription": {
                "text": "Elixir Pattern: Large Module Srp"
              },
              "fullDescription": {
                "text": "SRP Violation (God Module): Module 'Phoenix.VerifiedRoutes' defines 27 public functions and 46 routines, indicating multiple mixed domain responsibilities"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-ELIXIR-CYCLOMATIC_COMPLEXITY_KISS",
              "name": "cyclomatic_complexity_kiss",
              "shortDescription": {
                "text": "Elixir Pattern: Cyclomatic Complexity Kiss"
              },
              "fullDescription": {
                "text": "KISS Violation (High Complexity): Function 'config/1' in 'Phoenix.Endpoint.SupervisorTest' defines 24 pattern-matching clauses / 24 branches; decompose into smaller routines"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-ELIXIR-DUPLICATE_CODE_DRY",
              "name": "duplicate_code_dry",
              "shortDescription": {
                "text": "Elixir Pattern: Duplicate Code Dry"
              },
              "fullDescription": {
                "text": "DRY Violation: Identical function logic duplicated across 2 location(s): Phoenix.Integration.CodeGeneratorCase.random_string/1, MixHelper.random_string/1"
              },
              "properties": {
                "category": "principle"
              }
            }
          ]
        }
