            },
            {
              "id": "DPX-ELIXIR-STRING_TO_ATOM_VULNERABILITY",
              "name": "string_to_atom_vulnerability",
              "shortDescription": {
                "text": "Elixir Pattern: String To Atom Vulnerability"
              },
              "fullDescription": {
                "text": "Safety Audit (Atom Exhaustion Risk): Function 'conn/4' in 'Plug.Adapters.Test.Conn' calls `String.to_atom/1` on dynamic data; use `String.to_existing_atom/1` to prevent VM memory exhaustion"
              },
              "properties": {
                "category": "safety"
              }
            },
            {
              "id": "DPX-ELIXIR-CYCLOMATIC_COMPLEXITY_KISS",
              "name": "cyclomatic_complexity_kiss",
              "shortDescription": {
                "text": "Elixir Pattern: Cyclomatic Complexity Kiss"
              },
              "fullDescription": {
                "text": "KISS Violation (High Complexity): Function 'call/2' in 'Plug.StaticTest' defines 1 pattern-matching clauses / 20 branches; decompose into smaller routines"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-ELIXIR-DUPLICATE_CODE_DRY",
              "name": "duplicate_code_dry",
              "shortDescription": {
                "text": "Elixir Pattern: Duplicate Code Dry"
              },
              "fullDescription": {
                "text": "DRY Violation: Identical function logic duplicated across 2 location(s): Plug.TelemetryTest.attach/2, Plug.RouterTest.attach/2"
              },
              "properties": {
                "category": "principle"
              }
            }
          ]
