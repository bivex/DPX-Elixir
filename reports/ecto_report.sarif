{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "DPX-Elixir",
          "semanticVersion": "0.1.0",
          "rules": [
            {
              "id": "DPX-ELIXIR-GEN_SERVER",
              "name": "gen_server",
              "shortDescription": {
                "text": "Elixir Pattern: Gen Server"
              },
              "fullDescription": {
                "text": "Module 'Ecto.Repo.Registry' explicitly adopts OTP GenServer actor behaviour (`use GenServer`)"
              },
              "properties": {
                "category": "otp_behaviour"
              }
            },
            {
              "id": "DPX-ELIXIR-SUPERVISOR",
              "name": "supervisor",
              "shortDescription": {
                "text": "Elixir Pattern: Supervisor"
              },
              "fullDescription": {
                "text": "Module 'Ecto.Repo.Supervisor' adopts OTP Supervisor behaviour (`use Supervisor`)"
              },
              "properties": {
                "category": "otp_behaviour"
              }
            },
            {
              "id": "DPX-ELIXIR-TASK_ASYNC",
              "name": "task_async",
              "shortDescription": {
                "text": "Elixir Pattern: Task Async"
              },
              "fullDescription": {
                "text": "Function 'maybe_pmap/3' coordinates asynchronous parallel tasks / streams via Task module"
              },
              "properties": {
                "category": "actor_concurrency"
              }
            },
            {
              "id": "DPX-ELIXIR-APPLICATION",
              "name": "application",
              "shortDescription": {
                "text": "Elixir Pattern: Application"
              },
              "fullDescription": {
                "text": "Module 'Friends.Application' coordinates top-level application startup lifecycle (`use Application`)"
              },
              "properties": {
                "category": "otp_behaviour"
              }
            },
            {
              "id": "DPX-ELIXIR-PROTOCOL_POLYMORPHISM",
              "name": "protocol_polymorphism",
              "shortDescription": {
                "text": "Elixir Pattern: Protocol Polymorphism"
              },
              "fullDescription": {
                "text": "Protocol 'Ecto.Queryable' defines extensible polymorphism contract via defprotocol"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-ELIXIR-MACRO_METAPROGRAMMING",
              "name": "macro_metaprogramming",
              "shortDescription": {
                "text": "Elixir Pattern: Macro Metaprogramming"
              },
              "fullDescription": {
                "text": "Module 'Ecto.Integration.Schema' defines 1 compile-time macro(s) for DSL metaprogramming and provides `__using__/1` macro injection"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-ELIXIR-PIPELINE_OPERATOR",
              "name": "pipeline_operator",
              "shortDescription": {
                "text": "Elixir Pattern: Pipeline Operator"
              },
              "fullDescription": {
                "text": "Function 'order_changeset/2' composes functional data transformations across a 3-stage pipe (`|>`)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-ELIXIR-ETS_REGISTRY",
              "name": "ets_registry",
              "shortDescription": {
                "text": "Elixir Pattern: Ets Registry"
              },
              "fullDescription": {
                "text": "Module 'Ecto.Query.Planner' utilizes Registry / :ets shared memory for zero-copy concurrent process lookup and caching"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-ELIXIR-FACADE_CONTEXT",
              "name": "facade_context",
              "shortDescription": {
                "text": "Elixir Pattern: Facade Context"
              },
              "fullDescription": {
                "text": "Module 'Ecto.Repo.Queryable' serves as a Phoenix Context Facade encapsulating business operations (get_by, get_by!, update_all, delete_all)"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-ELIXIR-ADAPTER_BEHAVIOUR",
              "name": "adapter_behaviour",
              "shortDescription": {
                "text": "Elixir Pattern: Adapter Behaviour"
              },
              "fullDescription": {
                "text": "Module 'Ecto.Adapter' defines interchangeable Adapter Behaviour contract with 4 callback(s) (ensure_all_started/1, init/1, checkout/2, checked_out?/1)"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-ELIXIR-WITH_MONADIC_PIPELINE",
              "name": "with_monadic_pipeline",
              "shortDescription": {
                "text": "Elixir Pattern: With Monadic Pipeline"
              },
              "fullDescription": {
                "text": "Function '__using__/1' implements Railway-oriented Monadic pipeline with 4 sequential pattern matches (`with`)"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-ELIXIR-STRATEGY_DISPATCH",
              "name": "strategy_dispatch",
              "shortDescription": {
                "text": "Elixir Pattern: Strategy Dispatch"
              },
              "fullDescription": {
                "text": "Function 'apply_operation/4' dynamically dispatches behavior to pluggable Strategy/Adapter modules"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-ELIXIR-STRING_TO_ATOM_VULNERABILITY",
              "name": "string_to_atom_vulnerability",
              "shortDescription": {
                "text": "Elixir Pattern: String To Atom Vulnerability"
              },
              "fullDescription": {
                "text": "Safety Audit (Atom Exhaustion Risk): Function 'query/6' in 'Ecto.Query.Planner' calls `String.to_atom/1` on dynamic data; use `String.to_existing_atom/1` to prevent VM memory exhaustion"
              },
              "properties": {
                "category": "safety"
              }
            },
            {
              "id": "DPX-ELIXIR-LARGE_MODULE_SRP",
              "name": "large_module_srp",
              "shortDescription": {
                "text": "Elixir Pattern: Large Module Srp"
              },
              "fullDescription": {
                "text": "SRP Violation (God Module): Module 'Ecto.Multi' defines 36 public functions and 50 routines, indicating multiple mixed domain responsibilities"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-ELIXIR-CYCLOMATIC_COMPLEXITY_KISS",
              "name": "cyclomatic_complexity_kiss",
              "shortDescription": {
                "text": "Elixir Pattern: Cyclomatic Complexity Kiss"
              },
              "fullDescription": {
                "text": "KISS Violation (High Complexity): Function 'assoc/3' in 'Ecto' defines 1 pattern-matching clauses / 15 branches; decompose into smaller routines"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-ELIXIR-DUPLICATE_CODE_DRY",
              "name": "duplicate_code_dry",
              "shortDescription": {
                "text": "Elixir Pattern: Duplicate Code Dry"
              },
              "fullDescription": {
                "text": "DRY Violation: Identical function logic duplicated across 3 location(s): Ecto.RepoTest.select_fields/2, Ecto.Query.SubqueryTest.select_fields/2, Ecto.Query.PlannerTest.select_fields/2"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-ELIXIR-CIRCULAR_MODULE_DEPENDENCY",
              "name": "circular_module_dependency",
              "shortDescription": {
                "text": "Elixir Pattern: Circular Module Dependency"
              },
              "fullDescription": {
                "text": "Circular Module Dependency detected: Ecto ➔ Ecto.Association ➔ Ecto"
              },
              "properties": {
                "category": "principle"
              }
            }
          ]
        }
      },
