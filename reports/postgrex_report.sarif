              },
              "fullDescription": {
                "text": "Function 'range_x_range/5' composes functional data transformations across a 4-stage pipe (`|>`)"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-ELIXIR-ETS_REGISTRY",
              "name": "ets_registry",
              "shortDescription": {
                "text": "Elixir Pattern: Ets Registry"
              },
              "fullDescription": {
                "text": "Module 'Postgrex.Protocol' utilizes Registry / :ets shared memory for zero-copy concurrent process lookup and caching"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-ELIXIR-ADAPTER_BEHAVIOUR",
              "name": "adapter_behaviour",
              "shortDescription": {
                "text": "Elixir Pattern: Adapter Behaviour"
              },
              "fullDescription": {
                "text": "Module 'Postgrex.ReplicationConnection' defines interchangeable Adapter Behaviour contract with 7 callback(s) (init/1, handle_connect/1, handle_disconnect/1, handle_data/2, handle_info/2, handle_call/2, handle_result/1)"
              },
              "properties": {
                "category": "structural"
              }
            },
            {
              "id": "DPX-ELIXIR-COMMAND_TAGGED_TUPLE",
              "name": "command_tagged_tuple",
              "shortDescription": {
                "text": "Elixir Pattern: Command Tagged Tuple"
              },
              "fullDescription": {
                "text": "Function handle_call/3 in 'ReplicationTest' pattern matches on 5 distinct Command tagged tuples"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-ELIXIR-WITH_MONADIC_PIPELINE",
              "name": "with_monadic_pipeline",
              "shortDescription": {
                "text": "Elixir Pattern: With Monadic Pipeline"
              },
              "fullDescription": {
                "text": "Function 'binary_query/4' implements Railway-oriented Monadic pipeline with 2 sequential pattern matches (`with`)"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-ELIXIR-STRATEGY_DISPATCH",
              "name": "strategy_dispatch",
              "shortDescription": {
                "text": "Elixir Pattern: Strategy Dispatch"
              },
              "fullDescription": {
                "text": "Function 'handle/5' dynamically dispatches behavior to pluggable Strategy/Adapter modules"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-ELIXIR-STATE_MACHINE_STATEX",
              "name": "state_machine_statex",
              "shortDescription": {
                "text": "Elixir Pattern: State Machine Statex"
              },
              "fullDescription": {
                "text": "Module 'Postgrex.ReplicationConnection' implements Finite State Machine behaviour (`@behaviour :gen_statem`)"
              },
              "properties": {
                "category": "behavioral"
              }
            },
            {
              "id": "DPX-ELIXIR-UNBOUNDED_PROCESS_SPAWN",
              "name": "unbounded_process_spawn",
              "shortDescription": {
                "text": "Elixir Pattern: Unbounded Process Spawn"
              },
              "fullDescription": {
                "text": "Safety Audit (Unsupervised Process): Function 'new_status/2' in 'Postgrex.Protocol' calls raw `spawn/spawn_link`; use `Task.Supervisor` for fault tolerance and supervision"
              },
              "properties": {
                "category": "safety"
              }
            },
            {
              "id": "DPX-ELIXIR-STRING_TO_ATOM_VULNERABILITY",
              "name": "string_to_atom_vulnerability",
              "shortDescription": {
                "text": "Elixir Pattern: String To Atom Vulnerability"
              },
              "fullDescription": {
                "text": "Safety Audit (Atom Exhaustion Risk): Function 'new_status/2' in 'Postgrex.Protocol' calls `String.to_atom/1` on dynamic data; use `String.to_existing_atom/1` to prevent VM memory exhaustion"
              },
              "properties": {
                "category": "safety"
              }
            },
            {
              "id": "DPX-ELIXIR-CYCLOMATIC_COMPLEXITY_KISS",
              "name": "cyclomatic_complexity_kiss",
              "shortDescription": {
                "text": "Elixir Pattern: Cyclomatic Complexity Kiss"
              },
              "fullDescription": {
                "text": "KISS Violation (High Complexity): Function 'new_status/2' in 'Postgrex.Protocol' defines 1 pattern-matching clauses / 172 branches; decompose into smaller routines"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-ELIXIR-DUPLICATE_CODE_DRY",
              "name": "duplicate_code_dry",
              "shortDescription": {
                "text": "Elixir Pattern: Duplicate Code Dry"
              },
              "fullDescription": {
                "text": "DRY Violation: Identical function logic duplicated across 2 location(s): NotificationTest.disconnect/1, SimpleConnectionTest.disconnect/1"
              },
              "properties": {
                "category": "principle"
              }
            },
            {
              "id": "DPX-ELIXIR-CIRCULAR_MODULE_DEPENDENCY",
              "name": "circular_module_dependency",
              "shortDescription": {
                "text": "Elixir Pattern: Circular Module Dependency"
              },
              "fullDescription": {
                "text": "Circular Module Dependency detected: Postgrex.TypeModule ➔ Postgrex.Types ➔ Postgrex.TypeModule"
              },
              "properties": {
                "category": "principle"
              }
            }
          ]
        }
