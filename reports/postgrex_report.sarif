              },
              "properties": {
                "category": "otp_behaviour"
              }
            },
            {
              "id": "DPX-ELIXIR-TASK_ASYNC",
              "name": "task_async",
              "shortDescription": {
                "text": "Elixir Pattern: Task Async"
              },
              "fullDescription": {
                "text": "Function 'task_run/2' coordinates asynchronous parallel tasks / streams via Task module"
              },
              "properties": {
                "category": "actor_concurrency"
              }
            },
            {
              "id": "DPX-ELIXIR-APPLICATION",
              "name": "application",
              "shortDescription": {
                "text": "Elixir Pattern: Application"
              },
              "fullDescription": {
                "text": "Module 'Postgrex.App' coordinates top-level application startup lifecycle (`use Application`)"
              },
              "properties": {
                "category": "otp_behaviour"
              }
            },
            {
              "id": "DPX-ELIXIR-PROTOCOL_POLYMORPHISM",
              "name": "protocol_polymorphism",
              "shortDescription": {
                "text": "Elixir Pattern: Protocol Polymorphism"
              },
              "fullDescription": {
                "text": "Implementation 'Enumerable.Postgrex.Stream' provides concrete protocol implementation for Postgrex.Stream"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-ELIXIR-MACRO_METAPROGRAMMING",
              "name": "macro_metaprogramming",
              "shortDescription": {
                "text": "Elixir Pattern: Macro Metaprogramming"
              },
              "fullDescription": {
                "text": "Module 'Postgrex.TestHelper' defines 7 compile-time macro(s) for DSL metaprogramming"
              },
              "properties": {
